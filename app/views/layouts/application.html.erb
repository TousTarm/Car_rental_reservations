<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Car Rental" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Car Rental">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <%= link_to "Car Rental", root_path, class: "brand" %>
        <nav class="site-nav">
          <%= link_to "Find a car", root_path %>
          <%= link_to "Reservations", reservations_path %>
          <%= link_to "Add category", new_car_category_path %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice %>
        <p class="flash" role="status"><%= notice %></p>
      <% end %>
      <%= yield %>
    </main>

    <%# Demo shortcuts beside the main UI: one click searches the dates of a
        seeded scenario. Day offsets must match db/seeds.rb. %>
    <nav class="demo-panel" aria-label="Demo scenarios">
      <p class="demo-panel__title">Demo</p>
      <% [ [ "Almost full", 14, 16 ], [ "Sold out", 10, 12 ], [ "Overlapping", 25, 29 ], [ "All free", 40, 42 ] ].each do |label, from, to| %>
        <%= link_to label, root_path(start_date: Date.current + from, end_date: Date.current + to) %>
      <% end %>
    </nav>

    <footer class="site-footer">
      Tomáš Rindt · co-authored by <%= link_to "Claude", "https://claude.com/claude-code" %>
    </footer>
  </body>
</html>
