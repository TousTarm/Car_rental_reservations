<% content_for :title, "Find a car" %>

<section class="hero">
  <h1>When do you need a car?</h1>
  <p class="lead">Pick your dates and see which cars are free for the whole period.</p>

  <%= form_with url: root_path, method: :get, class: "search" do |f| %>
    <div class="field">
      <%= f.label :start_date, "From" %>
      <%= f.date_field :start_date, value: params[:start_date], min: Date.current, required: true %>
    </div>
    <div class="field">
      <%= f.label :end_date, "To" %>
      <%= f.date_field :end_date, value: params[:end_date], min: Date.current, required: true %>
    </div>
    <%= f.submit "Show available cars", name: nil, class: "btn btn--primary" %>
  <% end %>
</section>

<% if @date_errors.present? %>
  <div class="alert" role="alert">
    <ul>
      <% @date_errors.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @start_date %>
  <p class="muted">
    Availability for <strong><%= @start_date.to_fs(:long) %> – <%= @end_date.to_fs(:long) %></strong>
    (<%= pluralize((@end_date - @start_date).to_i + 1, "day") %>).
  </p>
<% end %>

<div class="card-grid">
  <% @categories.each do |category| %>
    <% free = category.free_units(@start_date, @end_date) if @start_date %>
    <article class="card <%= "card--sold-out" if free&.zero? %>">
      <div class="card__header">
        <h2 class="card__title"><%= category.name %></h2>
        <% if free.nil? %>
          <span class="badge"><%= pluralize(category.capacity, "car") %></span>
        <% elsif free.positive? %>
          <span class="badge badge--free"><%= free %> of <%= category.capacity %> free</span>
        <% else %>
          <span class="badge badge--full">Sold out</span>
        <% end %>
      </div>

      <p class="card__description"><%= category.description %></p>

      <div class="card__price">
        <span><%= czk(category.daily_price) %> / day</span>
        <% if @start_date %>
          <strong>Total <%= czk(category.price_for(@start_date, @end_date)) %></strong>
        <% end %>
      </div>

      <div class="card__actions">
        <%= link_to "Details", category, class: "btn" %>
        <% if free&.positive? %>
          <%= link_to "Book",
                new_reservation_path(car_category_id: category.id, start_date: @start_date, end_date: @end_date),
                class: "btn btn--primary" %>
        <% elsif free&.zero? %>
          <span class="btn btn--disabled" aria-disabled="true">Sold out</span>
        <% end %>
      </div>
    </article>
  <% end %>
</div>
